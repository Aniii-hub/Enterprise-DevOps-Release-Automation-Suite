# =====================================================================
# Enterprise DevOps & Release Automation Suite - Environment Template
# =====================================================================

# GitHub Configuration & Personal Access Token
GITHUB_TOKEN=your_github_personal_access_token_here
PAT_TOKEN=your_github_personal_access_token_here
GITHUB_ORG=your-organization-name
DEFAULT_SRC_BRANCH=dev
DEFAULT_TGT_BRANCH=uat

# Git Author Information
GIT_AUTHOR_NAME=Aniii-hub
GIT_AUTHOR_EMAIL=anirudhpardeshi25@gmail.com

# SMTP Notification Settings (Gmail / SendGrid / Amazon SES)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_specific_password_here
ALERT_EMAIL=devops-alerts@example.com

# Database Verification Kubernetes & Credential Presets
UAT_KUBECONFIG=~/.kube/uat-config.yaml
UAT_NAMESPACE=dev
UAT_DB_USER=postgres
UAT_DB_PASS=your_uat_db_password

DEV_KUBECONFIG=~/.kube/dev-config.yaml
DEV_NAMESPACE=dev
DEV_DB_USER=postgres
DEV_DB_PASS=your_dev_db_password

PROD_KUBECONFIG=~/.kube/prod-config.yaml
PROD_NAMESPACE=prod
PROD_DB_USER=postgres
PROD_DB_PASS=your_prod_db_password
